{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".validate": "newData.hasChildren(['width', 'height', 'createdAt'])"
        },
        "frame": {
          ".validate": "newData.hasChildren(['jpegBase64', 'ts'])"
        },
        "cmd": {
          ".validate": "newData.hasChildren(['type', 'ts'])"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['name'])"
          }
        }
      }
    }
  }
}
