<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hubungkan tanpa kode"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:text="Kalau diaktifkan, perangkat ini akan muncul di daftar perangkatmu saat kamu buka 'Kontrol perangkat lain' dari akun yang sama — tinggal pilih dan masukkan kata sandi, tidak perlu salin kode tiap kali."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="18dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Aktifkan fitur ini"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/radioMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:padding="18dp">

        <RadioButton
            android:id="@+id/radioNoPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tanpa kata sandi — langsung konek"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="14dp"
            android:text="Aman karena hanya akun ini (romand94901@gmail.com) yang bisa melihat dan menghubungkan ke perangkat ini."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/radioWithPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pakai kata sandi tambahan"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/primary"
            android:checked="true" />
    </RadioGroup>

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:hint="Kata sandi perangkat ini (minimal 6 karakter)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/RoundedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Simpan" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBattery"
        style="@style/RoundedButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🔋 Matikan optimasi baterai untuk aplikasi ini" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Penting di HP Xiaomi/Oppo/Vivo dkk. — tanpa ini, sistem bisa mematikan layanan latar belakang sehingga perangkat tidak bisa dihubungkan saat aplikasi tertutup."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
